{
  "name": "@local/dsh-remote-claude",
  "version": "0.3.3",
  "description": "Run Claude Code on a VPS while keeping workspace files, shell commands, approvals, and tool results inside DeepSeek Harness.",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./icon": "./assets/remote-claude.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "VALIDATION.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "INSTALL.md",
    "test",
    "scripts/check.mjs"
  ],
  "icon": "assets/remote-claude.svg",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "claude-code",
    "ssh",
    "mcp",
    "remote-agent"
  ],
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.1-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer"
      ],
      "immediately": true
    }
  },
  "scripts": {
    "test": "node --test --test-isolation=none test/*.test.js",
    "check": "node scripts/check.mjs && node --test --test-isolation=none test/*.test.js"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.2"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.5",
    "ssh2": "1.17.0"
  }
}
